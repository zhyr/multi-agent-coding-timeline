# ==============================================================================
# multi-agent-coding-timeline / .gitignore
#
# 仓库策略：只把源码、配置模板、以及需要公开的骨架文件纳入版本控制。
# 本地资料、大文件与二进制资产、各类缓存/构建产物、以及任何形式的
# 密钥凭证，一律不入库。
#
# 注意：GitHub 单文件硬上限 100 MB（超过 50 MB 会告警）。
#       确需版本化的大文件请改用 Git LFS 或外部对象存储，不要靠本文件放行。
# 验证某条规则是否命中：git check-ignore -v <path>
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 仓库策略：本地资料 / 内部文档
# ------------------------------------------------------------------------------
# 详细设计文档与验证报告属于内部工程资料，不作为开源内容发布。
# docs/ 下仅 docs/demo/ 的截图随仓库公开；根目录 *.md 一律忽略（本地保留）。
# 注：git rm --cached 已将其从索引移除，历史提交中仍可访问。
/docs/*.md

# 日期化的本地审计 / 交付产物目录（如 2026-11-17/implementation-review/、
# 2026-11-18/final-delivery/），含本地路径与审查过程信息，不入库。
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# ------------------------------------------------------------------------------
# 2. 本机环境 / 工具私有数据
# ------------------------------------------------------------------------------
# 本地 Agent 会话与记忆数据（含本地路径等私有信息，不随仓库公开）
.workbuddy/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 3. 编辑器 / IDE 本地配置
# ------------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.fleet/
.cursor/
.history/
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/
# 团队共享配置可按需放行：
# !.vscode/extensions.json
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json

# ------------------------------------------------------------------------------
# 4. 密钥 / 凭证 / 涉密文件（最高优先级，误提交后必须轮换密钥并清理历史）
#    规则刻意写得较精确，避免 *.secret* 这类过宽通配误伤源码文件。
# ------------------------------------------------------------------------------
# 环境变量
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.direnv/

# 私钥、证书、签名材料
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*
*_id_rsa
*_id_dsa
*.asc

# 平台 / 工具凭证目录与文件
.ssh/
.aws/
.azure/
.gcloud/
.gnupg/
.kube/
.npmrc
.pypirc
.netrc
.htpasswd
credentials.json
token.json
*.token
